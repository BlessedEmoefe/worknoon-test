# Database connection (used by Prisma)
# For local `npm run dev` / Prisma CLI on the host, use localhost.
# Inside Docker Compose the app overrides this to host `db`.
DATABASE_URL="postgresql://worknoon:worknoon123@localhost:5432/refund_system"

# OpenAI API Key (required for AI decisions)
OPENAI_API_KEY="your-openai-api-key-here"
